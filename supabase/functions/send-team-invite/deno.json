{
    "tasks": {
        "dev": "deno run --allow-net --allow-env --watch index.ts",
        "lint": "deno lint",
        "fmt": "deno fmt"
    },
    "lint": {
        "rules": {
            "tags": [
                "recommended"
            ]
        }
    },
    "fmt": {
        "options": {
            "singleQuote": true,
            "semiColons": false,
            "lineWidth": 100
        }
    }
}